# Valores del proyecto nuevo. Se crean en el equipo, fuera de cualquier repo (~/valores_<slug>.env),
# con un heredoc (el Bloc de notas de Windows agrega .txt y un carácter invisible al inicio). Luego:
#   bash instanciar.sh ~/valores_<slug>.env
# Una línea por valor, CLAVE=valor, sin comillas. Ninguno puede quedar vacío.

# Nombre visible del proyecto (como "Trama")
NOMBRE=
# Minúsculas, sin espacios: paquete, sesión tmux, carpeta del guardián (~/.SLUG)
SLUG=
# Una frase: qué es
DESCRIPCION_CORTA=
# Repo privado en GitHub (solo el nombre)
REPO=
CUENTA_GITHUB=tdkgo2
# Nombre del Project en claude.ai
PROJECT_CLAUDE=
# Carpeta del árbol de Code, relativa a HOME en el equipo (el worktree de main será RUTA_main)
RUTA=

LIDER=Tomek
REVISOR=Eduardo
DISPOSITIVO=Orange Pi 5
USUARIO_DISPOSITIVO=orangepi
IP_LAN=192.168.1.163
IP_TAILSCALE=100.97.168.28
# Carpeta de descargas PROPIA del proyecto en la laptop (p. ej. D:\Descargas\CronosLFT), sin espacios
DESCARGAS=
