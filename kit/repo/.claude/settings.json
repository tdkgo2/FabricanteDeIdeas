{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "/usr/bin/python3 /home/{{USUARIO_DISPOSITIVO}}/.{{SLUG}}/guardian/guardian.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fin_sesion.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(~/.{{SLUG}}/**)",
      "Write(~/.{{SLUG}}/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
